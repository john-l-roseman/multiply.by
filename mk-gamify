#!/usr/bin/env python3.10
"""Build a GAMIFIED game in the current directory, a folder of the site (for example
/var/www/multiply.by/train, served at https://multiply.by/train/), from a short request.

game.txt in this folder is the request, a few lines such as "a gamified version with a train
motif" (not the site's game.txt, the base spec). It is sent
to Claude (Fable 5.2 by default) as the prompt, with these files attached so the model needs
nothing from the web:
  - gamify.md, the guide for gamified versions (also served at https://multiply.by/gamify.md);
  - the base build instructions (the site's game.txt with layout.txt put in by assemble-spec),
    with GAME set to the folder name and SOURCE to this folder's game.txt (the request);
  - monster/custom.txt, the CUSTOMIZATION section of Multiply Monster, the worked example.
The model writes a CUSTOMIZATION section (the design) and then the game. The script saves:
  - customization.txt: the design;
  - index.html: the game, after check-scripts.py has passed it. Its SOURCE button opens game.txt.
Served files are written under a temporary name and renamed into place. If index.html is newer
than this game.txt, model, gamify.md, the site's game.txt, layout.txt and monster/custom.txt,
nothing is rebuilt (MK_FORCE=1, or touch game.txt, to force a build).

Usage, from the game's folder:  ../mk-gamify
The model is named in the file "model" in the game's folder: one line, a short name (carbon,
fable, opus, gpt, kimi) or a full model id (e.g. gemini-4-carbon, claude-fable-5-2, or an
OpenRouter id such as openai/gpt-6.1-terra). There is no default.
An id with a "/" is called through OpenRouter (key in $HOME/.openrouter-key); the cost shown is
the one OpenRouter reports.
Environment: MK_EFFORT (default high), MK_FORCE=1 to rebuild even when index.html is newer than
its inputs.
A model whose id starts with "gemini" (e.g. gemini-4-carbon) is called on Google Vertex
AI (project $GOOGLE_CLOUD_PROJECT, location global, MK_EFFORT as its thinking level), not
through /var/www/openlang.ai/SCRIPTS/run-vertex.py, whose model and system prompt are fixed.
The key is read from $HOME/.anthropic_key. A build costs a few dollars.
"""

import os
import re
import subprocess
import sys
import time

from anthropic import Anthropic

ROOT = "/var/www/multiply.by"
SPEC = f"{ROOT}/game.txt"
LAYOUT = f"{ROOT}/layout.txt"
GUIDE = f"{ROOT}/gamify.md"
EXAMPLE = f"{ROOT}/monster/custom.txt"
INPUT = "game.txt"  # in the game's folder: the request
MODEL_FILE = "model"  # in the game's folder: which model builds the game
SHORT_NAMES = {"carbon": "gemini-4-carbon", "fable": "claude-fable-5-2", "opus": "claude-opus-5-5",
               "gpt": "openai/gpt-6.1-terra", "kimi": "moonshotai/kimi-k3.1-pro"}  # OpenRouter
MODEL = None  # set by main() from MODEL_FILE
EFFORT = os.environ.get("MK_EFFORT", "high")
MAX_TOKENS = 128000
PRICES = {"claude-fable-5-2": (8.00, 40.00), "claude-opus-5-5": (4.00, 20.00)}  # $ per M tokens
# Gemini 4 Carbon: reported $2/$10 introductory price until 2026-11-30, then $4/$20 (not from
# Google's own pricing page: check it). Thinking tokens are billed as output.
CARBON = (2.00, 10.00) if time.strftime("%Y-%m-%d") < "2026-12-01" else (4.00, 20.00)
GEMINI_MAX_OUT = 65536  # thinking + answer per round; Gemini 4 Carbon gives no more
GEMINI_ROUNDS = 4
RESUME = "<<<RESUME>>>"  # the line a continued Gemini answer starts its new text after


def die(msg):
    sys.exit(f"mk-gamify: {msg}")


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def fail(answer, msg):
    """Stop without building; keep the model's raw answer for checking, outside the web folder."""
    path = f"/tmp/mk-gamify-{os.path.basename(os.getcwd())}-answer.txt"
    with open(path, "w", encoding="utf-8") as f:
        f.write(answer)
    die(f"{msg}; the raw answer is in {path}")


class Progress:
    """Prints a line about once a minute while an answer streams in, so a long build can be seen
    working (in build.log)."""
    def __init__(self, label=""):
        self.start = self.last = time.time()
        self.chars = 0
        self.label = label

    def add(self, text):
        self.chars += len(text or "")
        now = time.time()
        if now - self.last >= 60:
            self.last = now
            print(f"  {self.label}{(now - self.start) / 60:.0f} min: {self.chars:,} characters of "
                  "answer so far" + (" (still thinking)" if not self.chars else ""),
                  file=sys.stderr, flush=True)


def write_atomic(path, text):
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def base_instructions(name, rel):
    """The site's game.txt + layout.txt, with GAME set to the folder name and SOURCE to the
    folder's game.txt (the request)."""
    spec = read(SPEC)
    if not spec.startswith("NOTE FOR HUMAN R"):
        die(f"{SPEC} does not start with the Note for Human Readers")
    if len(re.findall(r"^- GAME: ", spec, re.M)) != 1:
        die(f'{SPEC} needs exactly one "- GAME: " line')
    if spec.count("https://multiply.by/build-instructions.txt") != 1:
        die(f"{SPEC} needs exactly one SOURCE link")
    text = subprocess.run([f"{ROOT}/assemble-spec", SPEC], capture_output=True, text=True,
                          check=True).stdout
    text = re.sub(r"^- GAME: .*$", f"- GAME: {name}", text, count=1, flags=re.M)
    return text.replace("https://multiply.by/build-instructions.txt",
                        f"https://multiply.by/{rel}/{INPUT}")


def prompt(request, name, rel, base):
    return f"""You are building a gamified version of the multiply.by times-tables game.

THE REQUEST (from the site's owner):
<request>
{request.strip()}
</request>

The new game's short name (CONFIG.GAME) is "{name}". It will be served at
https://multiply.by/{rel}/, and its SOURCE button opens the request above, published at
https://multiply.by/{rel}/{INPUT} (already set in the base file). The request may mention web
addresses of the files below: everything you need is attached here, so do not fetch anything.

Follow the guide in <gamify_md> exactly: G1 step 1 (DESIGN) and step 2 (BUILD). The base build
instructions are in <base_build_instructions> (GAME and SOURCE are already set for this game),
and the CUSTOMIZATION section of the worked example, Multiply Monster, is in
<monster_customization>.

Answer with exactly two parts and nothing else (no commentary, no markdown code fences):
1. <customization> ... </customization>: the complete CUSTOMIZATION section, starting with its
   banner, as the guide's G2 describes. It is published next to the game as its design,
   so it must stand on its own and describe the game you build.
2. <index_html> ... </index_html>: the complete standalone index.html, from <!DOCTYPE html> to
   </html>, built from the base build instructions with that section applied.

<gamify_md>
{read(GUIDE)}
</gamify_md>

<monster_customization>
{read(EXAMPLE)}
</monster_customization>

<base_build_instructions>
{base}
</base_build_instructions>
"""


def call_gemini(text):
    """Stream the answer from Vertex AI. Gemini stops at 65,536 output tokens (thinking included)
    whatever max_output_tokens says, with finish reason MAX_TOKENS or CONTINUATION; the answer
    is then continued (up to GEMINI_ROUNDS rounds in all), as run-vertex.py does."""
    from google import genai
    from google.genai import types
    client = genai.Client(vertexai=True, project=os.environ["GOOGLE_CLOUD_PROJECT"],
                          location="global", http_options={"timeout": 3_600_000})
    level = "low" if EFFORT == "low" else "high"
    print(f"Generating with {MODEL} on Vertex AI, thinking {level}...", file=sys.stderr)
    history = [types.Content(role="user", parts=[types.Part(text=text)])]
    answer, tin, tout, tthink = "", 0, 0, 0
    for rnd in range(1, GEMINI_ROUNDS + 1):
        out, usage, finish = [], None, None
        progress = Progress(f"round {rnd}, ")
        for chunk in client.models.generate_content_stream(
                model=MODEL, contents=history,
                config=types.GenerateContentConfig(
                    max_output_tokens=GEMINI_MAX_OUT,
                    thinking_config=types.ThinkingConfig(thinking_level=level))):
            if chunk.text:
                out.append(chunk.text)
            progress.add(chunk.text)
            if chunk.usage_metadata:
                usage = chunk.usage_metadata
            for c in chunk.candidates or []:
                if c.finish_reason:
                    finish = str(c.finish_reason)
        part_text = "".join(out)
        if rnd > 1:
            # The model may plan in plain words before it resumes (it did once, inside the code):
            # keep only what follows the last marker line.
            cut = part_text.rfind(RESUME)
            if cut < 0:
                fail(answer + part_text, f"round {rnd} has no {RESUME} line, so it can't be "
                     "joined to the previous round safely; nothing built")
            part_text = part_text[cut + len(RESUME):].lstrip("\n")
        answer += part_text
        if usage:
            tin += usage.prompt_token_count or 0
            tout += (usage.candidates_token_count or 0) + (usage.thoughts_token_count or 0)
            tthink += usage.thoughts_token_count or 0
        if not finish or finish.endswith("STOP"):
            break
        if not ("MAX_TOKENS" in finish or "CONTINUATION" in finish) or rnd == GEMINI_ROUNDS:
            report_gemini(tin, tout, tthink, rnd)
            fail(answer, f"the answer stopped early ({finish}); nothing built")
        print(f"Round {rnd} stopped at the output limit ({finish}); continuing...", file=sys.stderr)
        history += [types.Content(role="model", parts=[types.Part(text=part_text)]),
                    types.Content(role="user", parts=[types.Part(text=(
                        "You hit the output limit. Continue your answer exactly from the last "
                        f"character you wrote. Write the line {RESUME} first; right after it, "
                        "write the next characters of your answer: no repetition, no commentary, "
                        "no code fences, no planning after that line."))])]
    report_gemini(tin, tout, tthink, rnd)
    return answer


def report_gemini(tin, tout, tthink, rounds):
    pin, pout = CARBON if MODEL.startswith("gemini-4-carbon") else (0, 0)
    cost = f"${tin / 1e6 * pin + tout / 1e6 * pout:.2f}" if pin else "unknown (no price set)"
    print(f"Tokens: {tin:,} in, {tout:,} out (of which {tthink:,} thinking) in {rounds} "
          f"round(s); cost {cost}", file=sys.stderr)


def call_openrouter(text):
    """Stream the answer through OpenRouter's OpenAI-style API."""
    from openai import OpenAI
    client = OpenAI(base_url="https://openrouter.ai/api/v1", timeout=3600,
                    api_key=read(os.path.expanduser("~/.openrouter-key")).strip())
    print(f"Generating with {MODEL} through OpenRouter, effort {EFFORT}...", file=sys.stderr)
    out, usage, finish = [], None, None
    stream = client.chat.completions.create(
        model=MODEL, stream=True, max_tokens=MAX_TOKENS,
        messages=[{"role": "user", "content": text}],
        extra_body={"reasoning": {"effort": EFFORT if EFFORT in ("low", "medium", "high")
                                  else "high"},
                    "usage": {"include": True}})
    progress = Progress()
    for chunk in stream:
        if chunk.choices:
            c = chunk.choices[0]
            if c.delta and c.delta.content:
                out.append(c.delta.content)
            progress.add(c.delta.content if c.delta else "")
            if c.finish_reason:
                finish = c.finish_reason
        if getattr(chunk, "usage", None):
            usage = chunk.usage
    answer = "".join(out)
    if usage:
        u = usage.model_dump() if hasattr(usage, "model_dump") else dict(usage)
        think = (u.get("completion_tokens_details") or {}).get("reasoning_tokens") or 0
        cost = u.get("cost")
        print(f"Tokens: {u.get('prompt_tokens', 0):,} in, {u.get('completion_tokens', 0):,} out "
              f"(of which {think:,} thinking); cost "
              f"{f'${cost:.2f}' if cost is not None else 'not reported'}", file=sys.stderr)
    if finish != "stop":
        fail(answer, f"the answer stopped early ({finish}); nothing built")
    return answer


def call_claude(text):
    key = read(os.path.expanduser("~/.anthropic_key")).strip()
    client = Anthropic(api_key=key)
    print(f"Generating with {MODEL}, effort {EFFORT}...", file=sys.stderr)
    # Streamed, so a long answer never hits an HTTP timeout; on a policy decline the API reruns
    # the request on a fallback model (as about/run-claude.py does).
    with client.beta.messages.stream(
        model=MODEL, max_tokens=MAX_TOKENS,
        betas=["server-side-fallback-2026-07-01"],
        extra_body={"fallbacks": "default", "output_config": {"effort": EFFORT}},
        messages=[{"role": "user", "content": text}],
    ) as stream:
        progress = Progress()
        for event in stream:
            if event.type == "content_block_delta" and getattr(event.delta, "text", None):
                progress.add(event.delta.text)
            else:
                progress.add("")
        msg = stream.get_final_message()
    if msg.stop_reason == "refusal":
        die("Claude declined the request")
    if msg.stop_reason == "max_tokens":
        die(f"the answer was cut off at {MAX_TOKENS} tokens; nothing written")
    if msg.model != MODEL:
        print(f"Note: answered by {msg.model} (fallback)", file=sys.stderr)
    pin, pout = PRICES.get(msg.model, PRICES["claude-fable-5-2"])
    u = msg.usage
    print(f"Tokens: {u.input_tokens:,} in, {u.output_tokens:,} out; cost "
          f"${u.input_tokens / 1e6 * pin + u.output_tokens / 1e6 * pout:.2f}", file=sys.stderr)
    return "".join(b.text for b in msg.content if b.type == "text")


def part(answer, tag):
    found = re.findall(rf"<{tag}>\s*(.*?)\s*</{tag}>", answer, re.S)
    if not found:
        fail(answer, f"the answer has no <{tag}> part; nothing built")
    return found[-1]


def main():
    cwd = os.getcwd()
    if not cwd.startswith(ROOT + "/"):
        die(f"{cwd} is not a folder under {ROOT}")
    rel = cwd[len(ROOT) + 1:]
    name = os.path.basename(cwd)
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        die(f'folder name "{name}" may use only letters, digits, - and _')
    if not os.path.isfile(INPUT):
        die(f"no {INPUT} in {cwd}")
    if not os.path.isfile(MODEL_FILE):
        die(f'no "{MODEL_FILE}" file in {cwd}: write the model in it, e.g. carbon or fable')
    global MODEL
    words = read(MODEL_FILE).split()
    if len(words) != 1:
        die(f'"{MODEL_FILE}" must hold one model name, e.g. carbon or fable')
    MODEL = SHORT_NAMES.get(words[0].lower(), words[0])
    if "/" not in MODEL and not MODEL.startswith(("gemini", "claude")):
        die(f'unknown model "{words[0]}" in "{MODEL_FILE}": use {", ".join(SHORT_NAMES)}, a '
            "full gemini-... or claude-... model id, or an OpenRouter id (with a /)")
    print(f"GAMIFY: {name}")

    sources = [INPUT, MODEL_FILE, GUIDE, SPEC, LAYOUT, EXAMPLE]
    if not os.environ.get("MK_FORCE") and os.path.exists("index.html") and all(
            os.path.getmtime("index.html") > os.path.getmtime(s) for s in sources):
        print("index.html is newer than game.txt, model, gamify.md, the site's game.txt, "
              "layout.txt and monster/custom.txt; not rebuilding.")
        return

    base = base_instructions(name, rel)
    start = time.time()
    import atexit
    atexit.register(lambda: print(f"Took {(time.time() - start) / 60:.1f} minutes", file=sys.stderr))
    call = (call_openrouter if "/" in MODEL else
            call_gemini if MODEL.startswith("gemini") else call_claude)
    answer = call(prompt(read(INPUT), name, rel, base))

    section = part(answer, "customization")
    html = part(answer, "index_html")
    html = re.sub(r"^```(?:html)?\s*|\s*```$", "", html.strip())
    if not html.lower().startswith(("<!doctype", "<html")):
        fail(answer, "the index_html part does not start with <!DOCTYPE html>; nothing built")

    with open("index.html.tmp", "w", encoding="utf-8") as f:
        f.write(html + "\n")
    if subprocess.run(["python3", f"{ROOT}/check-scripts.py", "index.html.tmp"]).returncode:
        die("script check failed; the page is left in index.html.tmp")
    write_atomic("customization.txt", section + "\n")
    os.replace("index.html.tmp", "index.html")
    print(f"Built {cwd}/index.html ({os.path.getsize('index.html')} bytes)")


if __name__ == "__main__":
    main()
