#!/usr/bin/env python3.10
"""Build a GAMIFIED game in the current directory, a folder of the site (for example
/var/www/multiply.by/train, served at https://multiply.by/train/), from a short prompt.

prompt.txt in this folder is the prompt, a few lines such as "a gamified version with a train
motif", written as a person would type it into a chat (claude.ai, ChatGPT, Gemini), with a link
to https://multiply.by/gamify. The build does EXACTLY what such a chat does, so a build that
passes here shows that the prompt and /gamify/ work as published:
  - the model gets prompt.txt word for word, followed by the full text of each multiply.by file
    the prompt links to (as if the chat had fetched it in full; a page's text, as a fetch tool
    gives it): nothing else. No instructions
    from this script, no preset SOURCE or GAME, no worked example, no answer format.
  - from the answer, the page (<!DOCTYPE html> ... </html>) becomes index.html; whatever the
    model wrote before it (its CUSTOMIZATION design, if it followed gamify.md) is saved as
    customization.txt.
  - the page is checked, never changed: its scripts must parse (check-scripts.py) and its SOURCE
    must open this game's prompt.txt; a page that fails is not published. A GAME name shared with
    another game on the site (shared saved progress) is reported.
The only thing added to the conversation is mechanical: Gemini 4 Carbon stops each answer at
65,536 tokens and is asked to continue.
It also keeps a copy of each build in a subfolder named after the model (e.g. train/carbon/,
served at https://multiply.by/train/carbon/), so a build with another model doesn't replace it:
index.html, customization.txt and build.txt (model, date, tokens, cost, time, size). The folder's
own index.html is always the latest build, with its build.txt beside it.
Served files are written under a temporary name and renamed into place. If index.html is newer
than this prompt.txt, model and the files the prompt links to (/gamify/ is remade by make
first), nothing is rebuilt (MK_FORCE=1, or touch prompt.txt, to force a build).

Usage, from the game's folder:  ../mk-gamify
The model is named in the file "model" in the game's folder: one line, a short name (carbon,
fable, opus, gpt, kimi) or a full model id (e.g. gemini-4-carbon, claude-fable-5-2, or an
OpenRouter id such as openai/gpt-6.1-terra). There is no default.
An id with a "/" is called through OpenRouter (key in $HOME/.openrouter-key); the cost shown is
the one OpenRouter reports.
Environment: MK_MODEL=NAME builds with that model instead of the one in the "model" file;
MK_TRY=1 is a trial: the build goes ONLY into the model's subfolder (e.g. blocks/gemini-4-neon/),
the live index.html, build.txt and customization.txt are left as they are (to compare models
without publishing). MK_EFFORT (default high), MK_FORCE=1 to rebuild even when index.html is
newer than its inputs.
A model whose id starts with "gemini" (e.g. gemini-4-carbon) is called on Google Vertex
AI (project $GOOGLE_CLOUD_PROJECT, location global, MK_EFFORT as its thinking level), not
through /var/www/openlang.ai/SCRIPTS/run-vertex.py, whose model and system prompt are fixed.
The key is read from $HOME/.anthropic_key. A build costs a few dollars.
"""

import os
import re
import subprocess
import sys
import time

from anthropic import Anthropic

ROOT = "/var/www/multiply.by"
SITE = "https://multiply.by/"  # a link in the prompt under this address is "fetched" from ROOT
INPUT = "prompt.txt"  # in the game's folder: the prompt
MODEL_FILE = "model"  # in the game's folder: which model builds the game
SHORT_NAMES = {"carbon": "gemini-4-carbon", "fable": "claude-fable-5-2", "opus": "claude-opus-5-5",
               "gpt": "openai/gpt-6.1-terra", "kimi": "moonshotai/kimi-k3.1-pro"}  # OpenRouter
MODEL = None  # set by main() from MODEL_FILE
EFFORT = os.environ.get("MK_EFFORT", "high")
MAX_TOKENS = 128000
PRICES = {"claude-fable-5-2": (8.00, 40.00), "claude-opus-5-5": (4.00, 20.00)}  # $ per M tokens
# Gemini 4 Carbon: reported $2/$10 introductory price until 2026-11-30, then $4/$20 (not from
# Google's own pricing page: check it). Thinking tokens are billed as output.
CARBON = (2.00, 10.00) if time.strftime("%Y-%m-%d") < "2026-12-01" else (4.00, 20.00)
# Other Gemini 4 models, as reported by third-party sites in November 2026 (not from Google's own
# pricing page: check it).
GEMINI_PRICES = {"gemini-4-neon": (3.00, 15.00), "gemini-4-hydrogen": (1.50, 7.50),
                 "gemini-4-argon": CARBON}
TRY = bool(os.environ.get("MK_TRY"))
GEMINI_MAX_OUT = 65536  # thinking + answer per round; Gemini 4 Carbon gives no more
GEMINI_ROUNDS = 4
RESUME = "<<<RESUME>>>"  # the line a continued Gemini answer starts its new text after
REPORT = []  # lines about the build (tokens, cost), also written to <model>/build.txt


def note(msg):
    print(msg, file=sys.stderr)
    REPORT.append(msg)


def die(msg):
    sys.exit(f"mk-gamify: {msg}")


def read(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


def fail(answer, msg):
    """Stop without building; keep the model's raw answer for checking, outside the web folder."""
    path = f"/tmp/mk-gamify-{os.path.basename(os.getcwd())}-answer.txt"
    with open(path, "w", encoding="utf-8") as f:
        f.write(answer)
    die(f"{msg}; the raw answer is in {path}")


class Progress:
    """Prints a line about once a minute while an answer streams in, so a long build can be seen
    working (in build.log)."""
    def __init__(self, label=""):
        self.start = self.last = time.time()
        self.chars = 0
        self.label = label

    def add(self, text):
        self.chars += len(text or "")
        now = time.time()
        if now - self.last >= 60:
            self.last = now
            print(f"  {self.label}{(now - self.start) / 60:.0f} min: {self.chars:,} characters of "
                  "answer so far" + (" (still thinking)" if not self.chars else ""),
                  file=sys.stderr, flush=True)


def write_atomic(path, text):
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def linked_files(request):
    """The multiply.by files the prompt links to, as (address, local path), in order. A folder
    address (https://multiply.by/gamify) is its index.html. /gamify/ is generated: make remakes it
    first if gamify.md or the base game changed."""
    found = []
    for url in re.findall(r"https://multiply\.by/[^\s<>\"')]*", request):
        url = url.rstrip(".,;:")
        path = os.path.join(ROOT, url[len(SITE):] or "index.html")
        if os.path.isdir(path):
            path = os.path.join(path, "index.html")
        if os.path.relpath(path, ROOT) == "gamify/index.html":
            subprocess.run(["make", "-s", "-C", ROOT, "gamify/index.html"], check=True)
        if not os.path.isfile(path):
            die(f"the prompt links to {url}, but {path} does not exist")
        if (url, path) not in found:
            found.append((url, path))
    return found


def message(request, files):
    """What a chat gets: the prompt as typed, then each linked file as if fetched in full."""
    text = request.strip() + "\n"
    for url, path in files:
        body = read(path)
        if os.path.relpath(path, ROOT) == "gamify/index.html":
            # A fetch gives a page's text, not its markup: gamify.md as Markdown, then the base spec.
            body = subprocess.run(["python3", "gamify-html.py", "--text", "gamify.md", "base/prompt.txt"],
                                  cwd=ROOT, check=True, capture_output=True, text=True).stdout
        text += f"\n\n----- {url} (fetched, complete) -----\n\n{body}"
    return text


def call_gemini(text):
    """Stream the answer from Vertex AI. Gemini stops at 65,536 output tokens (thinking included)
    whatever max_output_tokens says, with finish reason MAX_TOKENS or CONTINUATION; the answer
    is then continued (up to GEMINI_ROUNDS rounds in all), as run-vertex.py does."""
    from google import genai
    from google.genai import types
    client = genai.Client(vertexai=True, project=os.environ["GOOGLE_CLOUD_PROJECT"],
                          location="global", http_options={"timeout": 3_600_000})
    level = "low" if EFFORT == "low" else "high"
    print(f"Generating with {MODEL} on Vertex AI, thinking {level}...", file=sys.stderr)
    history = [types.Content(role="user", parts=[types.Part(text=text)])]
    answer, tin, tout, tthink = "", 0, 0, 0
    for rnd in range(1, GEMINI_ROUNDS + 1):
        out, usage, finish = [], None, None
        progress = Progress(f"round {rnd}, ")
        for chunk in client.models.generate_content_stream(
                model=MODEL, contents=history,
                config=types.GenerateContentConfig(
                    max_output_tokens=GEMINI_MAX_OUT,
                    thinking_config=types.ThinkingConfig(thinking_level=level))):
            if chunk.text:
                out.append(chunk.text)
            progress.add(chunk.text)
            if chunk.usage_metadata:
                usage = chunk.usage_metadata
            for c in chunk.candidates or []:
                if c.finish_reason:
                    finish = str(c.finish_reason)
        part_text = "".join(out)
        if rnd > 1:
            # The model may plan in plain words before it resumes (it did once, inside the code):
            # keep only what follows the last marker line.
            cut = part_text.rfind(RESUME)
            if cut < 0:
                fail(answer + part_text, f"round {rnd} has no {RESUME} line, so it can't be "
                     "joined to the previous round safely; nothing built")
            part_text = part_text[cut + len(RESUME):].lstrip("\n")
        answer += part_text
        if usage:
            tin += usage.prompt_token_count or 0
            tout += (usage.candidates_token_count or 0) + (usage.thoughts_token_count or 0)
            tthink += usage.thoughts_token_count or 0
        if not finish or finish.endswith("STOP"):
            break
        if not ("MAX_TOKENS" in finish or "CONTINUATION" in finish) or rnd == GEMINI_ROUNDS:
            report_gemini(tin, tout, tthink, rnd)
            fail(answer, f"the answer stopped early ({finish}); nothing built")
        print(f"Round {rnd} stopped at the output limit ({finish}); continuing...", file=sys.stderr)
        history += [types.Content(role="model", parts=[types.Part(text=part_text)]),
                    types.Content(role="user", parts=[types.Part(text=(
                        "You hit the output limit. Continue your answer exactly from the last "
                        f"character you wrote. Write the line {RESUME} first; right after it, "
                        "write the next characters of your answer: no repetition, no commentary, "
                        "no code fences, no planning after that line."))])]
    report_gemini(tin, tout, tthink, rnd)
    return answer


def report_gemini(tin, tout, tthink, rounds):
    pin, pout = (CARBON if MODEL.startswith("gemini-4-carbon")
                 else GEMINI_PRICES.get(MODEL, (0, 0)))
    cost = f"${tin / 1e6 * pin + tout / 1e6 * pout:.2f}" if pin else "unknown (no price set)"
    note(f"Tokens: {tin:,} in, {tout:,} out (of which {tthink:,} thinking) in {rounds} "
         f"round(s); cost {cost}")


def call_openrouter(text):
    """Stream the answer through OpenRouter's OpenAI-style API."""
    from openai import OpenAI
    client = OpenAI(base_url="https://openrouter.ai/api/v1", timeout=3600,
                    api_key=read(os.path.expanduser("~/.openrouter-key")).strip())
    print(f"Generating with {MODEL} through OpenRouter, effort {EFFORT}...", file=sys.stderr)
    out, usage, finish = [], None, None
    stream = client.chat.completions.create(
        model=MODEL, stream=True, max_tokens=MAX_TOKENS,
        messages=[{"role": "user", "content": text}],
        extra_body={"reasoning": {"effort": EFFORT if EFFORT in ("low", "medium", "high")
                                  else "high"},
                    "usage": {"include": True}})
    progress = Progress()
    for chunk in stream:
        if chunk.choices:
            c = chunk.choices[0]
            if c.delta and c.delta.content:
                out.append(c.delta.content)
            progress.add(c.delta.content if c.delta else "")
            if c.finish_reason:
                finish = c.finish_reason
        if getattr(chunk, "usage", None):
            usage = chunk.usage
    answer = "".join(out)
    if usage:
        u = usage.model_dump() if hasattr(usage, "model_dump") else dict(usage)
        think = (u.get("completion_tokens_details") or {}).get("reasoning_tokens") or 0
        cost = u.get("cost")
        note(f"Tokens: {u.get('prompt_tokens', 0):,} in, {u.get('completion_tokens', 0):,} out "
             f"(of which {think:,} thinking); cost "
             f"{f'${cost:.2f}' if cost is not None else 'not reported'}")
    if finish != "stop":
        fail(answer, f"the answer stopped early ({finish}); nothing built")
    return answer


def call_claude(text):
    key = read(os.path.expanduser("~/.anthropic_key")).strip()
    client = Anthropic(api_key=key)
    print(f"Generating with {MODEL}, effort {EFFORT}...", file=sys.stderr)
    # Streamed, so a long answer never hits an HTTP timeout; on a policy decline the API reruns
    # the request on a fallback model (as about/run-claude.py does).
    with client.beta.messages.stream(
        model=MODEL, max_tokens=MAX_TOKENS,
        betas=["server-side-fallback-2026-07-01"],
        extra_body={"fallbacks": "default", "output_config": {"effort": EFFORT}},
        messages=[{"role": "user", "content": text}],
    ) as stream:
        progress = Progress()
        for event in stream:
            if event.type == "content_block_delta" and getattr(event.delta, "text", None):
                progress.add(event.delta.text)
            else:
                progress.add("")
        msg = stream.get_final_message()
    if msg.stop_reason == "refusal":
        die("Claude declined the request")
    if msg.stop_reason == "max_tokens":
        die(f"the answer was cut off at {MAX_TOKENS} tokens; nothing written")
    if msg.model != MODEL:
        note(f"Note: answered by {msg.model} (fallback)")
    pin, pout = PRICES.get(msg.model, PRICES["claude-fable-5-2"])
    u = msg.usage
    note(f"Tokens: {u.input_tokens:,} in, {u.output_tokens:,} out; cost "
         f"${u.input_tokens / 1e6 * pin + u.output_tokens / 1e6 * pout:.2f}")
    return "".join(b.text for b in msg.content if b.type == "text")


def split_answer(answer):
    """The page in the answer (the last <!DOCTYPE html> ... </html>, in or out of a code fence)
    and what the model wrote before it (its design), without fences."""
    m = None
    for m in re.finditer(r"<!DOCTYPE html.*?</html>", answer, re.S | re.I):
        pass
    if not m:
        fail(answer, "the answer has no page (<!DOCTYPE html> ... </html>); nothing built")
    before = re.sub(r"^```\w*\s*$", "", answer[:m.start()], flags=re.M).strip()
    return m.group(0), before


def source_link(html):
    """Where the page's SOURCE item points ("" if there is none)."""
    for m in re.finditer(r"<a\b[^>]*>\s*SOURCE\s*</a>", html, re.I):
        h = re.search(r"""href\s*=\s*["']([^"']*)["']""", m.group(0))
        return h.group(1) if h else ""
    return ""


def game_name(html):
    m = re.search(r"""\bGAME\s*:\s*["']([^"']+)["']""", html)
    return m.group(1) if m else None


def model_folder():
    """The subfolder for this model's copy: its short name (carbon, fable, ...) when it has one,
    else the model id with anything but letters, digits, '.', '-' and '_' turned into '-'."""
    for short, full in SHORT_NAMES.items():
        if MODEL == full:
            return short
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", MODEL).strip("-.")


def keep_copy(start):
    """Copy the build into the model's subfolder, with a build.txt about it. The same build.txt
    is also written next to the game's own index.html (the latest build), where the gallery
    reads the model and build time."""
    sub = model_folder()
    os.makedirs(sub, exist_ok=True)
    if not TRY:
        for f in ("index.html", "customization.txt"):
            write_atomic(f"{sub}/{f}", read(f))
    about = "\n".join([
        f"Model: {MODEL} (effort {EFFORT})",
        f"Built: {time.strftime('%Y-%m-%d %H:%M %Z')}",
        *REPORT,
        f"Time: {(time.time() - start) / 60:.1f} minutes",
        f"index.html: {os.path.getsize(f'{sub}/index.html' if TRY else 'index.html'):,} bytes",
    ]) + "\n"
    write_atomic(f"{sub}/build.txt", about)
    if not TRY:
        write_atomic("build.txt", about)
    print(f"Copy kept in {os.getcwd()}/{sub}/")


def main():
    cwd = os.getcwd()
    if not cwd.startswith(ROOT + "/"):
        die(f"{cwd} is not a folder under {ROOT}")
    rel = cwd[len(ROOT) + 1:]
    name = os.path.basename(cwd)
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        die(f'folder name "{name}" may use only letters, digits, - and _')
    if not os.path.isfile(INPUT):
        die(f"no {INPUT} in {cwd}")
    if not os.path.isfile(MODEL_FILE):
        die(f'no "{MODEL_FILE}" file in {cwd}: write the model in it, e.g. carbon or fable')
    global MODEL
    words = (os.environ.get("MK_MODEL") or read(MODEL_FILE)).split()
    if len(words) != 1:
        die(f'"{MODEL_FILE}" must hold one model name, e.g. carbon or fable')
    MODEL = SHORT_NAMES.get(words[0].lower(), words[0])
    if "/" not in MODEL and not MODEL.startswith(("gemini", "claude")):
        die(f'unknown model "{words[0]}" in "{MODEL_FILE}": use {", ".join(SHORT_NAMES)}, a '
            "full gemini-... or claude-... model id, or an OpenRouter id (with a /)")
    print(f"GAMIFY: {name}")

    request = read(INPUT)
    files = linked_files(request)
    if not files:
        print(f"Note: {INPUT} links to no multiply.by file, so the model gets the prompt alone.")
    sources = [INPUT, MODEL_FILE] + [p for _, p in files]
    if not TRY and not os.environ.get("MK_FORCE") and os.path.exists("index.html") and all(
            os.path.getmtime("index.html") > os.path.getmtime(s) for s in sources):
        print(f"index.html is newer than {', '.join(os.path.relpath(s) for s in sources)}; "
              "not rebuilding.")
        return

    start = time.time()
    import atexit
    atexit.register(lambda: print(f"Took {(time.time() - start) / 60:.1f} minutes", file=sys.stderr))
    call = (call_openrouter if "/" in MODEL else
            call_gemini if MODEL.startswith("gemini") else call_claude)
    answer = call(message(request, files))
    html, section = split_answer(answer)

    # Checks only: the page is published as the model wrote it, or not at all.
    src = source_link(html)
    ok = {INPUT, "./" + INPUT, f"/{rel}/{INPUT}", f"{SITE}{rel}/{INPUT}"}
    if src not in ok:
        bad = f"{model_folder()}/index.html.tmp" if TRY else "index.html.tmp"
        os.makedirs(os.path.dirname(bad) or ".", exist_ok=True)
        with open(bad, "w", encoding="utf-8") as f:
            f.write(html + "\n")
        die(f'SOURCE points to "{src}", not to this game\'s {INPUT}; nothing published (the '
            f"page is in {bad})")
    game = game_name(html)
    others = {}
    for d in os.listdir(ROOT):
        page = os.path.join(ROOT, d, "index.html")
        if d != name and os.path.isfile(page):
            others[game_name(read(page))] = d
    others[game_name(read(os.path.join(ROOT, "build", "index.html")))] = "the base game"
    if game is None:
        note("Warning: no CONFIG.GAME found in the page")
    elif game in others:
        note(f'Warning: GAME "{game}" is also used by {others[game]} (they share saved progress)')

    design = (section or "(The model wrote no design before the page.)") + "\n"
    if TRY:
        sub = model_folder()
        os.makedirs(sub, exist_ok=True)
        tmp = f"{sub}/index.html.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(html + "\n")
        if subprocess.run(["python3", f"{ROOT}/check-scripts.py", tmp]).returncode:
            die(f"script check failed; the page is left in {tmp}")
        write_atomic(f"{sub}/customization.txt", design)
        os.replace(tmp, f"{sub}/index.html")
        print(f"Trial built {cwd}/{sub}/index.html ({os.path.getsize(sub + '/index.html')} bytes); "
              "the live page is unchanged")
        keep_copy(start)
        return
    with open("index.html.tmp", "w", encoding="utf-8") as f:
        f.write(html + "\n")
    if subprocess.run(["python3", f"{ROOT}/check-scripts.py", "index.html.tmp"]).returncode:
        die("script check failed; the page is left in index.html.tmp")
    write_atomic("customization.txt", design)
    os.replace("index.html.tmp", "index.html")
    print(f"Built {cwd}/index.html ({os.path.getsize('index.html')} bytes)")
    keep_copy(start)


if __name__ == "__main__":
    main()
