#!/bin/bash
# Write a page's complete build instructions to stdout: the page's own spec (for example
# game.txt or about/about.txt) with its one "#include layout.txt" line replaced by the site's
# shared layout.txt (title band, share icon, menu bar, footer).
#
# Usage: assemble-spec PAGE.txt > build-instructions.txt

ROOT=$(cd "$(dirname "$0")" && pwd)
PAGE=$1
if [ ! -f "$PAGE" ]; then echo "assemble-spec: no file \"$PAGE\"" >&2; exit 1; fi
if [ "$(grep -c '^#include layout\.txt$' "$PAGE")" != 1 ]; then
	echo "assemble-spec: $PAGE needs exactly one \"#include layout.txt\" line" >&2; exit 1
fi
sed -e '/^#include layout\.txt$/{r '"$ROOT/layout.txt" -e 'd}' "$PAGE"
