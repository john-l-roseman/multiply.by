# Track only the source files; everything else is generated by make.
/*
!/.gitignore
!/Makefile
!/extract-files.py
!/CLAUDE.md
!/game.txt
!/layout.txt
!/assemble-spec
!/PWA-build.txt
!/about/
/about/*
!/about/about.txt
!/about/Makefile
!/check-scripts.py
!/reformat-spec.py
!/MATCH-TO-FOUR.txt
!/mk-custom
!/chinese/
/chinese/*
!/chinese/custom.txt
!/match/
/match/*
!/match/build-instructions.txt
!/match/Makefile
