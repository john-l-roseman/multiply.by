!/about/about.txt
!/about/Makefile
!/demo/
/demo/*
!/demo/demo.txt
!/demo/page.txt
!/demo/Makefile
!/build-it/
/build-it/*
!/build-it/page.txt
!/build-it/Makefile
!/build-it/shots.py
!/build-it/thumbs.py
!/thumbnails/
!/games/
/games/*
!/games/page.txt
!/games/Makefile
!/check-scripts.py
!/gamify-txt.py
!/reformat-spec.py
!/MATCH-TO-FOUR.txt
!/mk-custom
!/mk-gamify
!/run-model
!/model
!/chinese/
/chinese/*
!/chinese/prompt.txt
!/chinese/model
!/divide/
/divide/*
!/divide/custom.txt
!/monster/
/monster/*
