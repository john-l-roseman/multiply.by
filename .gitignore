# Track only the source files; everything else is generated by make.
/*
!/.gitignore
!/Makefile
!/extract-files.py
!/build-instructions.txt
!/PWA-build.txt
!/about/
/about/*
!/about/build-instructions.txt
!/about/Makefile
!/check-scripts.py
!/check-data.py
!/reformat-spec.py
!/MATCH-TO-FOUR.txt
!/mk-custom
!/Custom/
/Custom/*
!/Custom/*/
/Custom/*/*
!/Custom/*/custom.txt
!/match/
/match/*
!/match/build-instructions.txt
!/match/Makefile
